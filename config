# baby-menu (scratchpad toggle: Mod1+Shift+o). Deployed at ~/dev/baby-menu,
# runs the built output in Linux window mode (frameless compact panel).
# WM_CLASS verified live on this machine: instance "baby-menu", class "baby-menu".
# No fixed size here on purpose: Baby Menu owns its responsive bounds.
for_window [class="^baby-menu$"] floating enable, border pixel 0, move position center, move scratchpad
exec --no-startup-id sh -c 'cd ~/dev/baby-menu && BABY_MENU_WINDOW_MODE=1 exec ./node_modules/electron/dist/electron . >> /tmp/baby-menu.log 2>&1'
bindsym $mod+Shift+o [class="^baby-menu$"] scratchpad show
