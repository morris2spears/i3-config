bindsym $mod+Return exec --no-startup-id $term
# firstmate: attach to the herdr server on mirage over tailscale ssh.
# --remote starts the server there if it isn't up, and keeps modern terminal
# features (image paste) that plain ssh + multiplexer drops. detach with ctrl+b q.
# Toggles a centred floating overlay like $mod+y / $mod+Shift+y do, and hides
# those two when it comes up. $term is passed through so this machine's DPI
# wrapper is still used; $mod+q hides this window rather than killing the
# connection.
bindsym $mod+Shift+i exec --no-startup-id ~/.config/i3/scripts/toggle_firstmate.sh $term

# Pre-warm firstmate at login so the first $mod+Shift+i is instant instead of
# waiting on the SSH attach: launches it and hides it in the scratchpad once the
# window appears. Waits for mirage to be reachable first and quietly creates no
# window if it never is, so a failed login never parks a dead terminal in the
# scratchpad. `exec`, not `exec_always` -- an i3 reload must not relaunch it.
#
# This sits down here, away from the other exec lines at the top of the file, ON
# PURPOSE: i3 substitutes variables in file order, so $term is only defined from
# its `set` line onward. Used any earlier it would pass through as the literal
# string "$term" and the pre-warm would silently never start.
exec --no-startup-id ~/.config/i3/scripts/start_firstmate_hidden.sh $term

# Pre-warm spotify at login the same way, so the first $mod+Shift+s of the day is
# an instant scratchpad pull instead of a cold client start. Launches spotify and
# moves it to the scratchpad once the window appears -- it cannot rely on the
# for_window rule to hide it, because that rule deliberately has no "move
# scratchpad" (the toggle's launch branch has to show the window). Exits silently
# having created nothing if spotify is not installed. `exec`, not `exec_always`
# -- an i3 reload must not relaunch it.
#
# This one uses no i3 variables, so unlike the firstmate line above its position
# in the file is not load-bearing; it lives here purely to keep the two pre-warms
# together.
exec --no-startup-id ~/.config/i3/scripts/start_spotify_hidden.sh
